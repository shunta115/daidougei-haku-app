# Client (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud

# Server (Vercel /api) — never expose these to the client
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Stripe test keys (sk_test_...) for Phase 1. Live charges stay off unless you opt in.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Production public origin. Never localhost / 127.0.0.1.
APP_URL=https://your-app.vercel.app
# Required to charge with sk_live_ keys. Leave unset while using test keys.
# STRIPE_ALLOW_LIVE=true

# LiveKit (native live streaming)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret
