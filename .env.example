# Client (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
VITE_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY
# Public VAPID key only. Safe for the browser; never put the private key here.
VITE_WEB_PUSH_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
# Server (Vercel /api) — never expose these to the client
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Stripe test keys (sk_test_...) for Phase 1. Live charges stay off unless you opt in.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Production public origin. Never localhost / 127.0.0.1.
APP_URL=https://your-app.vercel.app
# Web Push stays disabled until the migration, VAPID keys, and delivery audit are approved.
# ENABLE_APPEARANCE_WEB_PUSH=true
WEB_PUSH_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
WEB_PUSH_VAPID_PRIVATE_KEY=YOUR_SERVER_ONLY_VAPID_PRIVATE_KEY
WEB_PUSH_SUBJECT=mailto:ops@example.com
# Required to charge with sk_live_ keys. Leave unset while using test keys.
# STRIPE_ALLOW_LIVE=true
# Separately enables live Connect Transfers after the production payout audit.
# Keep unset until an operator explicitly approves real performer payments.
# ENABLE_LIVE_PERFORMER_TRANSFERS=true

# LiveKit (native live streaming)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret

# SMART PUSH draft: enable only after approved migration and device QA.
# All remain OFF by default; existing self-test remains OFF after PR117.
VITE_ENABLE_SMART_PUSH=false
ENABLE_SMART_PUSH=false
ENABLE_LIVE_START_WEB_PUSH=false
# Isolated TEST preview only; exact TEST URL is also required by code.
VITE_SMART_PUSH_TEST_LIFECYCLE=false
