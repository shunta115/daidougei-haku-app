{
  "name": "daidougei-haku-app",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/guard-production-source.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:live": "vitest run tests/p0-readiness.test.ts tests/live-camera.test.ts tests/live-comments.test.ts tests/live-comment-moderation-migration.test.ts tests/live-release-gate.test.ts tests/live-end-location.test.ts tests/payment-safety.test.ts tests/tip-approval.test.ts tests/tip-confirmation.test.ts tests/direct-live-lifecycle.test.ts tests/direct-live-token.test.ts tests/direct-live-presence.test.ts tests/direct-live-jwt.test.ts tests/youtube-player-recovery.test.tsx tests/youtube-live-simple-ui.test.tsx",
    "test:registration": "vitest run",
    "test:safari": "node tests/e2e/run.mjs && node tests/qr-share-e2e/run.mjs",
    "typecheck:live-server": "tsc -p tsconfig.live-server.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "framer-motion": "^11.0.0",
    "leaflet": "1.9.4",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "1.9.21",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^5.8.27",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^26.1.0",
    "playwright": "1.59.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
