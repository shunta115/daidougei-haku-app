{
  "git": { "deploymentEnabled": { "codex/home-activity-20261031": false } },
  "crons": [
    { "path": "/api/ops/run?job=stripe-transfer-retry", "schedule": "0 0 * * *" }
  ],
  "rewrites": [
    { "source": "/api/profile/display-name", "destination": "/api/stripe/tip?action=display-name" },
    { "source": "/api/votes/device", "destination": "/api/ops/run?job=votes-device" },
    { "source": "/api/awp-results", "destination": "/api/ops/run?job=awp-results" },
    {
      "source": "/official",
      "destination": "/official-v6.html"
    },
    {
      "source": "/api/haku-admin",
      "destination": "/api/ops/inbox"
    },
    {
      "source": "/api/livekit/status",
      "destination": "/api/livekit/presence?mode=status"
    },
    {
      "source": "/haku-admin",
      "destination": "/haku-admin.html"
    },
    {
      "source": "/haku-admin/(.*)",
      "destination": "/haku-admin.html"
    },
    {
      "source": "/((?!api/)(?!haku-admin).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
